{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chopd",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pr-flow-db",
      "database_id": "922cb1b1-f88b-437e-bcdb-e6e7fd3682d4",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
